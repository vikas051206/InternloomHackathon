{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "MONGODB_USERNAME": "@mongodb_username",
    "MONGODB_PASSWORD": "@mongodb_password",
    "MONGODB_CLUSTER": "@mongodb_cluster",
    "MONGODB_DATABASE": "@mongodb_database"
  }
}
